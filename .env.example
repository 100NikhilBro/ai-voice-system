# ==========================================
# Health Insurance Knowledge Base Configuration
# ==========================================

APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000

# PostgreSQL + pgvector
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/health_insurance_kb
POSTGRES_DB=health_insurance_kb
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Embeddings & LLM
EMBEDDING_PROVIDER=local
LOCAL_EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384

# Optional: OpenAI (only when EMBEDDING_PROVIDER=openai)
OPENAI_API_KEY=your_openai_api_key_here
EMBEDDING_MODEL=text-embedding-3-small

# Knowledge Base Paths
RAW_DOCS_DIR=domains/health_insurance/raw_docs
KB_STORE_DIR=domains/health_insurance/kb_store
FALLBACK_SQLITE_PATH=domains/health_insurance/kb_store/health_kb_fallback.db

# Retrieval Controls
RETRIEVAL_SCORE_THRESHOLD=0.65
RETRIEVAL_TOP_K=5
RRF_K=60
